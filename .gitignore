# =========================================================================
# Maven
# =========================================================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.nextReleaseBackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Avoid committing the wrapper jar if you prefer, but keep the properties
# !.mvn/wrapper/maven-wrapper.jar

# =========================================================================
# IntelliJ IDEA
# =========================================================================
# Covers user-specific and high-churn IDE files
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml

# Exclude module files since Maven auto-import recreates them
*.iml
*.iws
*.ipr

# OPTIONAL: Uncomment the line below if you prefer to completely ignore
# the entire .idea folder (common for pure Maven projects)
# .idea/

# =========================================================================
# Java & Operating Systems
# =========================================================================
# Compiled class files
*.class
*.log

# Package Archives
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz

# Crash logs
hs_err_pid*
replay_pid*

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
